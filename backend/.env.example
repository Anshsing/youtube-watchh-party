# Copy this to .env and fill in values for local development.
# Never commit .env to git.

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Allowed frontend origin for CORS.
# In production, set this to your Vercel frontend URL.
# e.g. CORS_ORIGIN=https://your-app.vercel.app
# Leave as * for local dev (allows all origins).
CORS_ORIGIN=*
